{
  "name": "play-pokemon-attendance-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && esbuild server/bootstrap/launcher.ts --bundle --platform=node --format=esm --target=node22 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=.output/launcher.mjs",
    "start": "node .output/launcher.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:server": "vitest run --project server",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "spike:s1": "tsx spikes/s1-connect.ts",
    "spike:s2": "tsx spikes/s2-refresh.ts",
    "spike:s3": "tsx spikes/s3-discover.ts",
    "spike:s4": "tsx spikes/s4-bulk.ts",
    "spike:fixtures": "tsx spikes/sanitize-fixtures.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@nuxt/ui": "^4.11.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "nuxt": "^4.6.1",
    "nuxt-auth-utils": "^0.5.31",
    "nuxt-security": "^2.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@semantic-release/exec": "^7.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "msw": "^2.15.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "vue-demi"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-v5rq-49vh-5v5c",
        "GHSA-x6jw-m9v5-85vh",
        "GHSA-g4wm-2vf7-vfgr",
        "GHSA-858h-whjf-mvg5"
      ]
    }
  }
}
